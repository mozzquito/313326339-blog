---
import BaseLayout from '../layouts/BaseLayout.astro';
const postModules = import.meta.glob('./posts/*.md', { eager: true });
const posts = Object.values(postModules) as any[];
const sorted = posts
  .sort((a, b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date));
---
<BaseLayout title="Home">
  <section class="hero">
    <h1>Tech Digest 🇹🇭</h1>
    <p>สรุป event และ tools จาก tech community ไทย เขียนโดย Phongcheat</p>
  </section>

  <div class="posts">
    {sorted.map(post => (
      <a href={post.url} class="card">
        <div class="card-meta">
          <span class="type">{post.frontmatter.type === 'event' ? '🎪 Event' : '🔧 Tool'}</span>
          <time>{new Date(post.frontmatter.date).toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
        </div>
        <h2>{post.frontmatter.title}</h2>
        <p class="excerpt">{post.frontmatter.description}</p>
        <div class="tags">
          {(post.frontmatter.tags || []).map(tag => <span>#{tag}</span>)}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .hero { margin-bottom: 3rem; }
  .hero h1 { font-size: 2.5rem; font-weight: 800; margin-bottom: 0.5rem; }
  .hero p { color: #888; font-size: 1.1rem; }
  .posts { display: flex; flex-direction: column; gap: 1.5rem; }
  .card {
    display: block;
    border: 1px solid #222;
    border-radius: 10px;
    padding: 1.5rem;
    transition: border-color 0.2s;
    color: inherit;
    text-decoration: none;
  }
  .card:hover { border-color: #7dd3fc; }
  .card-meta { display: flex; gap: 1rem; font-size: 0.8rem; color: #666; margin-bottom: 0.6rem; align-items: center; }
  .type { color: #7dd3fc; }
  .card h2 { font-size: 1.2rem; margin-bottom: 0.5rem; color: #fff; }
  .excerpt { color: #888; font-size: 0.95rem; margin-bottom: 0.8rem; }
  .tags { display: flex; gap: 0.5rem; font-size: 0.8rem; color: #555; flex-wrap: wrap; }
</style>
