---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
const { title, date, tags = [], description, type = 'post' } = frontmatter;
const formattedDate = new Date(date).toLocaleDateString('th-TH', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---
<BaseLayout title={title} description={description}>
  <article>
    <div class="meta">
      <span class="type">{type === 'event' ? '🎪 Event' : '🔧 Tool'}</span>
      <time>{formattedDate}</time>
    </div>
    <h1>{title}</h1>
    {tags.length > 0 && (
      <div class="tags">
        {tags.map(tag => <span class="tag">#{tag}</span>)}
      </div>
    )}
    <div class="content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  article { padding-top: 1rem; }
  .meta {
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
    color: #666;
    margin-bottom: 1rem;
    align-items: center;
  }
  .type {
    background: #1a1a2e;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.8rem;
    color: #7dd3fc;
    border: 1px solid #2a2a4e;
  }
  h1 { font-size: 2rem; font-weight: 700; margin-bottom: 1rem; line-height: 1.3; }
  .tags { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .tag { font-size: 0.8rem; color: #888; }
  .content { margin-top: 2rem; }
  .content :global(h2) { font-size: 1.4rem; margin: 2rem 0 1rem; }
  .content :global(h3) { font-size: 1.1rem; margin: 1.5rem 0 0.5rem; }
  .content :global(p) { margin-bottom: 1.2rem; }
  .content :global(ul), .content :global(ol) { margin: 1rem 0 1.2rem 1.5rem; }
  .content :global(li) { margin-bottom: 0.4rem; }
  .content :global(blockquote) {
    border-left: 3px solid #7dd3fc;
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: #aaa;
    font-style: italic;
  }
  .content :global(code) {
    background: #1a1a1a;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    font-size: 0.9em;
    color: #f472b6;
  }
  .content :global(pre) {
    background: #1a1a1a;
    padding: 1rem;
    border-radius: 6px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .content :global(img) { max-width: 100%; border-radius: 8px; margin: 1.5rem 0; }
  .content :global(hr) { border: none; border-top: 1px solid #222; margin: 2rem 0; }
</style>
